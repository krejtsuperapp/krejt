# KREJT — variablat e mjedisit (§73). VETËM EMRA. Vlerat reale jetojnë në AWS Secrets Manager.
APP_ENV=development                      # development | staging | production
AWS_REGION=eu-central-1

# Baza e të dhënave (Aurora PostgreSQL) — vlerat vijnë nga Secrets Manager (krejt/dev/aurora/master)
DATABASE_URL=
DATABASE_REPLICA_URL=

# Redis (ElastiCache, TLS + auth) — krejt/dev/redis/auth
REDIS_URL=

# Radhët & ngjarjet
SQS_DISPATCH_QUEUE_URL=
SQS_NOTIFICATIONS_QUEUE_URL=
SQS_OUTBOX_QUEUE_URL=
SQS_PAYOUTS_QUEUE_URL=
SNS_DOMAIN_EVENTS_TOPIC_ARN=
EVENTS_PUBLISHER=sns                     # sns | devlog (VETËM development: ngjarjet vetëm logohen)

# Object storage
S3_ASSETS_BUCKET=
STORAGE_PROVIDER=s3                      # s3 | devfs (VETËM development: disk lokal + PUT /api/v1/dev/uploads)
PUBLIC_BASE_URL=https://api.krejt.app    # URL-ja publike e API-së

# Realtime
CENTRIFUGO_API_URL=
CENTRIFUGO_API_KEY=                      # Secrets Manager: krejt/dev/centrifugo
CENTRIFUGO_TOKEN_HMAC_SECRET=
REALTIME_PROVIDER=centrifugo             # centrifugo | devlog (VETËM development)

# Hartat
GOOGLE_MAPS_KEY=                         # Secrets Manager: krejt/dev/google-maps (kur MAPS_PROVIDER=google)
MAPBOX_TOKEN=                            # Secrets Manager: krejt/dev/mapbox-token (kur MAPS_PROVIDER=mapbox)
MAPS_PROVIDER=google                     # google | mapbox | devestimate (VETËM development: vlerësim pa ofrues)

# Njoftimet
FCM_SERVICE_ACCOUNT_JSON=                # Secrets Manager: krejt/dev/fcm
PUSH_PROVIDER=fcm                        # fcm | devlog (VETËM development: push-et vetëm logohen)
# Numri që merr SUPER_ADMIN në nisje, dhe vetëm nëse ende nuk ka asnjë administrator.
# Pa të, administratori i parë nuk lind kurrë: të drejtat jepen vetëm nga një administrator.
BOOTSTRAP_ADMIN_PHONE=
# Dokumentet e miratuara para aprovimit të shoferit. false lejohet VETËM në development.
DOCUMENTS_REQUIRED=true

SMS_PROVIDER=infobip                     # infobip | devlog (VETËM development)
INFOBIP_BASE_URL=https://api.infobip.com # URL-ja e llogarisë tënde Infobip (xxxxx.api.infobip.com)
INFOBIP_API_KEY=                         # Secrets Manager: krejt/dev/infobip
INFOBIP_SENDER=KREJT

# OTP: pepper për hash-in e kodeve (>= 16 byte, i rastësishëm; Secrets Manager: krejt/dev/jwt)
OTP_PEPPER=
EMAIL_PROVIDER=postmark
EMAIL_API_KEY=                           # Secrets Manager: krejt/dev/postmark

# Pagesat (kartë + cash; PA P2P) — §24: qëllim pagese te ofruesi, sukses VETËM nga webhook-u i nënshkruar
PAYMENT_PROVIDER=stripe                  # stripe | devlog (VETËM development: suksesi vetëm nga endpoint-i dev)
STRIPE_SECRET_KEY=                       # Secrets Manager: krejt/dev/payment-provider (secret_key)
STRIPE_WEBHOOK_SECRET=                   # Secrets Manager: krejt/dev/payment-provider (webhook_secret)

# Autentikimi
JWT_PRIVATE_KEY=                         # Secrets Manager: krejt/dev/jwt
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
POSTHOG_KEY=                             # Secrets Manager: krejt/dev/posthog
POSTHOG_HOST=https://eu.i.posthog.com
ANALYTICS_PROVIDER=posthog               # posthog | devlog (VETËM development)
OTEL_EXPORTER_OTLP_HEADERS=              # Secrets Manager: krejt/dev/otel (Authorization=Basic …)
OTEL_TRACES_SAMPLER_ARG=0.2              # përqindja e gjurmëve (0–1)
