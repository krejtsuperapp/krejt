<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Serveri i zhvillimit rri në laptop dhe flet http, ndërsa Android-i e bllokon http-në që
         nga API 28. Kjo e hap vetëm për ndërtimin debug: skedari ndodhet te src/debug, ndaj
         ndërtimi për dyqan nuk e merr kurrë dhe atje rregulli mbetet i plotë. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
